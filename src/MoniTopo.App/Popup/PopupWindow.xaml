<Window x:Class="MoniTopo.App.Popup.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MoniTopo profiles"
        Width="360"
        MaxHeight="560"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </Window.Resources>
    <Border BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="16,13,16,8">
                <TextBlock Text="Display profiles" FontSize="14" FontWeight="SemiBold" />
                <TextBlock FontSize="11" Opacity="0.65">
                    <Run Text="Current: " /><Run Text="{Binding CurrentState, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <Grid Grid.Row="1" Margin="7,2,7,9">
                <TextBlock Text="No profiles saved"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="12,22"
                           Opacity="0.62">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Profiles.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ListBox x:Name="ProfileList"
                         ItemsSource="{Binding Profiles}"
                         SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewMouseLeftButtonUp="OnProfileClick"
                         AutomationProperties.Name="Display profiles">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="114" ItemHeight="120" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Width" Value="114" />
                            <Setter Property="Height" Value="120" />
                            <Setter Property="Padding" Value="4" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Margin="3" Padding="{TemplateBinding Padding}" CornerRadius="5"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                                <Grid ToolTip="{Binding AccessibleName}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="52" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <ItemsControl ItemsSource="{Binding Monitors}" Width="90" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Canvas Width="90" Height="46" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="1.5"
                                                            BorderThickness="{Binding StrokeThickness}"
                                                            BorderBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="✓"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibility}}"
                                                   AutomationProperties.Name="Active profile" />
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Name}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="2" Text="{Binding HotkeyText}" FontSize="11" MinHeight="16" Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Border Grid.Row="2"
                    Padding="12,8"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    Visibility="{Binding HasStatusMessage, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
            </Border>

            <Grid x:Name="UpdateActions" Grid.Row="3" Margin="12,0,12,0"
                  Visibility="{Binding ShowUpdateAction, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="Release notes" Padding="9,7" Margin="0,0,8,0" VerticalAlignment="Stretch"
                        IsEnabled="{Binding CanViewReleaseNotes, Mode=OneWay}"
                        Click="OnReleaseNotesClick" AutomationProperties.Name="View release notes" />
                <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="9,7"
                        IsEnabled="{Binding CanRunUpdateAction, Mode=OneWay}"
                        Click="OnUpdateClick"
                        AutomationProperties.Name="Update MoniTopo">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="!" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding UpdateActionText, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="›" FontSize="18" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </Grid>

            <Grid Grid.Row="4" Margin="12,6,7,7">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MoniTopo" FontSize="10" Margin="0,0,7,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding VersionText, Mode=OneWay}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="OpenMainWindowButton"
                        Content="&#xE713;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="16"
                        Width="34"
                        Height="30"
                        Padding="0"
                        HorizontalAlignment="Right"
                        Click="OnMainWindowClick"
                        ToolTip="Open MoniTopo"
                        AutomationProperties.Name="Open MoniTopo" />
            </Grid>
        </Grid>
    </Border>
</Window>
