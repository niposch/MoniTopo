<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <StartupObject>MoniTopo.App.Program</StartupObject>
    <!-- WPF0001: ThemeMode is still marked experimental in .NET 10, but it is
         the framework-provided Fluent system-theme API selected by the product spec. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MoniTopo.Core\MoniTopo.Core.csproj" />
    <ProjectReference Include="..\MoniTopo.Recovery\MoniTopo.Recovery.csproj" />
    <ProjectReference Include="..\MoniTopo.Windows\MoniTopo.Windows.csproj" />
  </ItemGroup>

</Project>
