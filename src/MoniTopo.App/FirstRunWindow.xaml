<Window x:Class="MoniTopo.App.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up MoniTopo"
        Width="430"
        Height="245"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="MoniTopo" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Margin="0,8,0,0"
                   Text="Save and switch complete Windows display configurations."
                   TextWrapping="Wrap" />
        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <CheckBox x:Name="StartAtLoginCheckBox"
                      Content="Start MoniTopo when I sign in"
                      IsChecked="True" />
            <TextBlock x:Name="PortableWarningText"
                       Margin="24,8,0,0"
                       Opacity="0.72"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>
        <Button Grid.Row="3"
                HorizontalAlignment="Right"
                MinWidth="88"
                Padding="12,7"
                IsDefault="True"
                Content="Finish"
                Click="OnFinishClick" />
    </Grid>
</Window>
