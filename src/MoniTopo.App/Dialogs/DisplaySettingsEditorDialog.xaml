<Window x:Class="MoniTopo.App.Dialogs.DisplaySettingsEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit display settings" Width="660" Height="600" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Edit display settings" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Original.Name, Mode=OneWay}" Margin="0,4,0,8" FontWeight="SemiBold" />
            <TextBlock Text="Save changes to this profile, then Activate to apply them. Monitor arrangement stays the same; connected edges move with a resolution change."
                       TextWrapping="Wrap" />
            <TextBlock Text="Options reflect the connected displays. Windows validates the combined settings when you activate the profile."
                       TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save profile" IsDefault="True" IsEnabled="{Binding HasChanges, Mode=OneWay}" Click="OnSaveClick" Margin="0,0,8,0" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Displays, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,8,18">
                            <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Resolution" />
                                <ComboBox Grid.Row="1" Margin="0,4,0,10" ItemsSource="{Binding Resolutions}"
                                          SelectedItem="{Binding SelectedResolution, Mode=TwoWay}" IsEnabled="{Binding CanEditMode}" AutomationProperties.Name="Resolution" />
                                <TextBlock Grid.Column="2" Text="Refresh rate" />
                                <ComboBox Grid.Row="1" Grid.Column="2" Margin="0,4,0,10" ItemsSource="{Binding RefreshRates}"
                                          SelectedItem="{Binding SelectedRefreshRate, Mode=TwoWay}" IsEnabled="{Binding CanEditMode}" AutomationProperties.Name="Refresh rate" />
                                <TextBlock Grid.Row="2" Text="Windows scale" />
                                <ComboBox Grid.Row="3" Margin="0,4,0,0" ItemsSource="{Binding Scales}"
                                          SelectedItem="{Binding SelectedScale, Mode=TwoWay}" IsEnabled="{Binding CanEditScale}" AutomationProperties.Name="Windows scale" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="HDR" />
                                <ComboBox Grid.Row="3" Grid.Column="2" Margin="0,4,0,0" ItemsSource="{Binding HdrStates}"
                                          SelectedItem="{Binding SelectedHdr, Mode=TwoWay}" IsEnabled="{Binding CanEditHdr}" AutomationProperties.Name="HDR" />
                            </Grid>
                            <TextBlock Text="{Binding AvailabilityMessage, Mode=OneWay}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
